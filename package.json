{
  "name": "wenyan-pilot",
  "version": "0.5.2",
  "private": true,
  "description": "Pilot study platform: questioning vs direct-answer AI assistance for Classical Chinese reading",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node scripts/verify-build.mjs",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "tsx scripts/validate-content.ts",
    "smoke": "tsx scripts/smoke-run.ts",
    "prompts:inspect": "tsx scripts/inspect-prompts.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "check:http": "node scripts/check-http.mjs",
    "check:llm": "tsx scripts/check-llm.ts",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:dump": "tsx scripts/database.ts dump",
    "db:import": "tsx scripts/database.ts import",
    "build:collection": "npm run validate:content && npm run build"
  },
  "dependencies": {
    "next": "^15.5.24",
    "pg": "^8.23.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
