# Copy to .env.local and fill in. Never commit .env.local.

# --- LLM ---
# LLM_PROVIDER: mock | anthropic | gemini
#   mock      = fully offline, no key needed (use this for UI work and tests)
#   anthropic = Claude          -> needs ANTHROPIC_API_KEY
#   gemini    = Google Gemini   -> needs GEMINI_API_KEY
LLM_PROVIDER=mock

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Pin the exact model string; write it into the paper's method section.
# anthropic example: claude-3-5-haiku-20241022
# gemini   examples: gemini-2.5-flash (stable, good price/performance)
#                    gemini-3.5-flash-lite (cheapest, fastest)
#                    gemini-3.6-flash (Google's replacement for the retired 2.0-flash)
# Do NOT use gemini-2.0-flash: shut down (earliest 2026-06-01) per
# https://ai.google.dev/gemini-api/docs/deprecations
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=300

# --- storage ---
# File store (default). One JSON file; fine for a 45-person pilot on one server.
DATA_FILE=./data/db.json

# --- admin ---
ADMIN_PASSWORD=change-me

# --- stratification cut points (freeze before collection starts) ---
STRATUM_LOW=3
STRATUM_HIGH=6
