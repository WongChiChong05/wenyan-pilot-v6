# Copy to .env.local and fill in. Never commit .env.local.

# --- LLM ---
# LLM_PROVIDER: mock | anthropic | gemini
#   mock      = fully offline, no key needed (use this for UI work and tests)
#   anthropic = Claude          -> needs ANTHROPIC_API_KEY
#   gemini    = Google Gemini   -> needs GEMINI_API_KEY
#
# With no key at all the app falls back to a mock whose output says
# 「（示範模式：未接上模型）」 — that string is deliberate, so a session run without a key
# by mistake is obvious in the exported data instead of looking like real content.
LLM_PROVIDER=mock

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- the model ---
# REQUIRED whenever LLM_PROVIDER is anthropic or gemini. There is no default: the app
# refuses to start a real provider without it, because data that cannot be attributed to
# a specific model is not reportable.
#
# Pin the EXACT DATED ID, not an alias like "sonnet" or "claude-sonnet-latest". An alias
# silently moves to a new model mid-study and splits your data across two models.
#
# Get the current ids from your own account rather than from any doc that may be stale:
#   Invoke-RestMethod -Uri https://api.anthropic.com/v1/models `
#     -Headers @{ "x-api-key" = "<your key>"; "anthropic-version" = "2023-06-01" } |
#     Select-Object -ExpandProperty data | Format-Table id, display_name
# or read https://platform.claude.com/docs/en/models/overview
#
# Freeze this value on the day collection starts and write it into the method section.
# CONFIG.version is exported with every row so the analysis can prove which config ran.
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=300

# --- storage ---
# Supabase PostgreSQL transaction-pooler URL (server-only, never NEXT_PUBLIC_*).
# Use SSL with certificate verification; do not disable certificate checks.
DATABASE_URL=
# Optional direct/session-pooler URL for migrations.
DATABASE_MIGRATION_URL=
# Explicitly set collection only AFTER reviewer sign-off and validation.
STUDY_MODE=dry-run
# File store is local development only. Production requires DATABASE_URL.
DATA_FILE=./data/db.json

# --- admin ---
ADMIN_PASSWORD=change-me

# --- stratification cut points (freeze before collection starts) ---
STRATUM_LOW=3
STRATUM_HIGH=6
